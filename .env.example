# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Postgres (must have pgvector extension available) ──────────────────────
# Local docker-compose default; override in production.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jobsfound
DATABASE_MAX_POOL=10
DATABASE_CONNECT_TIMEOUT_MS=30000

# ── GLM (Z.ai / ZhipuAI) — OPTIONAL ─────────────────────────────────────────
# Without GLM_API_KEY the app runs fine; chat simply requires visitors to
# add their own key in the browser (BYOK). Set it only if you want a shared
# key for anonymous users.
# Same key, two wallets/protocols — pick the one your plan has tokens on:
#   Coding Plan (Anthropic-compatible): https://api.z.ai/api/anthropic
#   API balance (pay-as-you-go):        https://api.z.ai/api/paas/v4
# (or the open.bigmodel.cn equivalents).
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/anthropic
GLM_MODEL_ADMIN=glm-4.6
GLM_MODEL_USER=glm-4.5-air

# ── Embedding strategy ─────────────────────────────────────────────────────
# local       = transformers.js on-host (default; needs Bun/Node, ~130MB model)
# cloudflare  = Workers AI REST, SAME bge-small-en-v1.5 model, free tier
#               (vectors are identical — switching providers needs no re-embed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH=64
EMBEDDING_WORKER_INTERVAL_CRON=* * * * *
EMBEDDING_MAX_RETRIES=6

# Cloudflare Workers AI (only needed when EMBEDDING_PROVIDER=cloudflare)
# Dashboard → Workers AI → API tokens (Account ID on the overview page).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Adzuna (https://developer.adzuna.com — free key) ────────────────────────
# Optional: source disables itself when unset. Countries: any Adzuna market
# (au, sg, nz, in, …). AU + SG by default; tech category only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=au,sg

# ── Admin ──────────────────────────────────────────────────────────────────
# Any request with x-api-key matching this value is treated as admin
# (unlimited GLM-4.6 chat, no rate limit, admin endpoints unlocked).
ADMIN_API_KEY=

# ── Rate limit (per-IP, per-day) for anonymous users ───────────────────────
RATE_LIMIT_PER_DAY=10

# ── Data hygiene ───────────────────────────────────────────────────────────
JOB_STALENESS_DAYS=30

# ── CV upload ──────────────────────────────────────────────────────────────
# 4MB: Vercel functions hard-reject request bodies larger than 4.5MB.
CV_MAX_BYTES=4194304

# ── Serverless ingest (Vercel cron → POST /api/ingest) ─────────────────────
# Vercel automatically sends "Authorization: Bearer $CRON_SECRET" on cron
# requests when CRON_SECRET is set. VERCEL_URL is provided by the platform.
INGEST_TIME_BUDGET_MS=50000
CRON_SECRET=
VERCEL_URL=

# ── Cron schedules (override to throttle sources independently) ────────────
CRON_ARBEITNOW=0 * * * *
CRON_REMOTIVE=30 * * * *
CRON_REMOTEOK=15 */4 * * *
CRON_GREENHOUSE=0 */2 * * *
CRON_LEVER=30 */2 * * *
CRON_ASHBY=0 */3 * * *
CRON_CLEANUP=17 3 * * *
