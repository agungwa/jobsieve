{
  "name": "jobs-found",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "build:web": "bun run --cwd web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "ingest": "bun src/scripts/ingest.ts",
    "ingest:embedding-worker": "bun src/scripts/embedding-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "aho-corasick": "^0.1.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "mammoth": "^1.12.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.5",
    "unpdf": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
